<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\internal-nlog.txt">

  <!-- Ziele definieren (z.B. Datei, Konsole) -->
  <targets>
    <target name="logfile"
            xsi:type="File"
            fileName="c:\logs\${shortdate}.log"
            layout="${longdate} ${uppercase:${level}} ${message}" />

    <target name="console"
            xsi:type="Console"
            layout="${message}" />

    <target name="debugger"
        xsi:type="debugger"
        layout="${message}" />
  </targets>

  <!-- Regeln definieren, welche Ziele verwendet werden sollen -->
  <rules>
    <!-- Swallow the raw USB/IP packet trace (<</>> hex dumps) from VirtualUsbDevice; CTAP2-level
         Debug logs from the same class still flow through the rules below. -->
    <logger name="VFido.Core.Device.VirtualUsbDevice" minlevel="Trace" maxlevel="Trace" final="true" />

    <logger name="*" minlevel="Info" writeTo="logfile" />
    <logger name="*" minlevel="Trace" writeTo="console" />
    <logger name="*" minlevel="Trace" writeTo="debugger" />
  </rules>
</nlog>