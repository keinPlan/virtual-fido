<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.Dialogs.AddStickWindow"
        Title="Add stick"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <ScrollViewer MaxHeight="600">
        <StackPanel Margin="16" Spacing="12">
            <StackPanel x:Name="SecretManagerSection" Spacing="4">
                <TextBlock Text="Secret manager"/>
                <ComboBox x:Name="SecretManagerTypeBox" HorizontalAlignment="Stretch" SelectionChanged="SecretManagerType_SelectionChanged">
                    <ComboBoxItem Content="Memory (not persisted)"/>
                    <ComboBoxItem Content="File-based"/>
                    <ComboBoxItem Content="mTLS server"/>
                    <ComboBoxItem Content="TPM 2.0 (Windows)"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Name"/>
                <TextBox x:Name="NameBox" MaxLength="32" Watermark="Letters, digits, '.', '_', '-' - no spaces"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Serial number"/>
                <TextBox x:Name="SerialNumberBox"/>
            </StackPanel>

            <StackPanel x:Name="FilePanel" Spacing="12" IsVisible="False">
                <StackPanel Spacing="4">
                    <TextBlock Text="Username"/>
                    <TextBox x:Name="FileUsernameBox"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Password"/>
                    <TextBox x:Name="FilePasswordBox" PasswordChar="*"/>
                    <TextBlock Text="Used now to initialize the encrypted key store - not saved, so you'll enter it again each time you Connect." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="MtlsPanel" Spacing="12" IsVisible="False">
                <StackPanel Spacing="4">
                    <TextBlock Text="Server base address"/>
                    <TextBox x:Name="MtlsServerAddressBox" Text="https://localhost:5443" Watermark="https://secrets.example.internal:5443"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Login password"/>
                    <TextBox x:Name="MtlsLoginPasswordBox" PasswordChar="*"/>
                    <TextBlock Text="Used now to test the connection - not saved, so you'll enter it again each time you Connect." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Client certificate (.pfx)"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="MtlsClientCertPathBox" Grid.Column="0"/>
                        <Button Content="Browse..." Grid.Column="1" Margin="8,0,0,0" Click="BrowseClientCert_Click"/>
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Client certificate password (optional)"/>
                    <TextBox x:Name="MtlsClientCertPasswordBox" PasswordChar="*"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Server CA certificate"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="MtlsServerCaCertPathBox" Grid.Column="0"/>
                        <Button Content="Browse..." Grid.Column="1" Margin="8,0,0,0" Click="BrowseServerCaCert_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="TpmPanel" Spacing="12" IsVisible="False">
                <TextBlock x:Name="TpmProvisionHint" Text="Import a master recovery PFX or create one below. Signing keys will be used inside this computer's TPM." Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                <StackPanel x:Name="TpmMetadataPanel" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Username"/>
                        <TextBox x:Name="TpmUsernameBox"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Metadata password"/>
                        <TextBox x:Name="TpmMetadataPasswordBox" PasswordChar="*"/>
                        <TextBlock Text="Encrypts account details and PIN state, and authorizes the TPM master. Enter it again when connecting or restoring. It is separate from the recovery PFX password and is never saved." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Master recovery PFX"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="TpmPfxPathBox" Grid.Column="0"/>
                        <Button Content="Browse..." Grid.Column="1" Margin="8,0,0,0" Click="BrowseTpmPfx_Click"/>
                    </Grid>
                    <Button x:Name="TpmCreateMasterButton" Content="Create recovery PFX..." Click="CreateTpmMaster_Click"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Recovery PFX password"/>
                    <TextBox x:Name="TpmPfxPasswordBox" PasswordChar="*"/>
                    <TextBlock Text="Used only for provisioning or recovery. Keep this PFX and password, plus a backup of the stick folder and its metadata password, to recover your credentials." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="TpmRestoreButton" Content="Restore master on this TPM" IsVisible="False" Click="RestoreTpmMaster_Click"/>
                <Button x:Name="TpmDeletePrimaryButton" Content="Delete cached TPM primary (0x81015646)..." IsVisible="False" Click="DeleteTpmPrimary_Click"/>
            </StackPanel>

            <TextBlock x:Name="ProgressText" Text="Working..." TextWrapping="Wrap" IsVisible="False"/>
            <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="False"/>

            <Grid ColumnDefinitions="*,Auto">
                <Button x:Name="DeleteButton" Grid.Column="0" Content="Delete" HorizontalAlignment="Left"
                        IsVisible="False" Click="Delete_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
                    <Button x:Name="CreateButton" Content="Create" Width="80" Click="Create_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
