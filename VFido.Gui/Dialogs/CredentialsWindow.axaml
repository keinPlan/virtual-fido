<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.Dialogs.CredentialsWindow"
        Title="Credentials"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="SubtitleText" Grid.Row="0" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="CredentialListPanel" Spacing="8"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="80" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
