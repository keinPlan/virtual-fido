<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.Dialogs.CredentialsWindow"
        Title="Credentials"
        Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="SubtitleText" Grid.Row="0" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <StackPanel x:Name="TransferActions" Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Create transfer certificate" Click="CreateTransferCertificate_Click"/>
                <Button x:Name="ExportButton" Content="Export selected" Click="ExportPasskeys_Click"/>
                <Button x:Name="ImportButton" Content="Import passkeys" Click="ImportPasskeys_Click"/>
            </StackPanel>
            <TextBlock x:Name="TransferHint" TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="CredentialListPanel" Spacing="8"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="80" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
