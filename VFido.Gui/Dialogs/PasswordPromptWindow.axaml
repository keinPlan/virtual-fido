<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.Dialogs.PasswordPromptWindow"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" Text="Username" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Grid.Row="2" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="Password" Margin="0,0,0,4"/>
        <TextBox x:Name="PasswordBox" Grid.Row="4" PasswordChar="*" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
            <Button Content="Connect" Width="80" Click="Connect_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
