<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.Dialogs.PasswordPromptWindow"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"/>

        <StackPanel x:Name="UsernamePanel" Grid.Row="1" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameBox"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Password"/>
            <TextBox x:Name="PasswordBox" PasswordChar="*"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
            <Button Content="Connect" Width="80" Click="Connect_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
