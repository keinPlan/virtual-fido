<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.Dialogs.ConfirmWindow"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="Delete" Width="80" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
