<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VFido.Gui.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="VFidoSurfaceBrush" Color="#191C25"/>
        <SolidColorBrush x:Key="VFidoCardBrush" Color="#242834"/>
        <SolidColorBrush x:Key="VFidoAccentBrush" Color="#465975"/>
        <SolidColorBrush x:Key="VFidoAccentHoverBrush" Color="#526884"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource VFidoAccentBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style Selector="Button.primary, Button[IsDefault=True]">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource VFidoAccentBrush}"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button[IsDefault=True]:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource VFidoAccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Styles>

</Application>
