<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.UserPresence.ApprovalWindow"
        Title="Security key request"
        Width="360" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="DeviceText" Grid.Row="0" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock x:Name="OperationText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="RpText" Grid.Row="2" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="CountdownText" Grid.Row="3" Foreground="Gray" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Spacing="8">
            <Button Content="Deny" Width="80" Click="Deny_Click"/>
            <Button Content="Approve" Width="80" Click="Approve_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
