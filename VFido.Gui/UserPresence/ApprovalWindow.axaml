<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VFido.Gui.UserPresence.ApprovalWindow"
        Title="Security key request"
        Width="380" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None">
    <Border CornerRadius="12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="#3A6FF7" BorderThickness="1"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header banner -->
            <Border Grid.Row="0" Padding="16,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#3A6FF7" Offset="0"/>
                        <GradientStop Color="#7A3AF7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="🔐" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Security key request" FontWeight="Bold" FontSize="15" Foreground="White"/>
                        <TextBlock x:Name="DeviceText" FontSize="11" Foreground="#E4E9FF"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="16,14" Spacing="10">
                <TextBlock x:Name="OperationText" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RpText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <ProgressBar x:Name="CountdownBar" Height="4" Minimum="0" CornerRadius="2"
                                 Foreground="#3A6FF7" BorderThickness="0"/>
                    <TextBlock x:Name="CountdownText" Foreground="Gray" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16" Spacing="8">
                <Button Content="Deny" Width="90" Click="Deny_Click" CornerRadius="6"/>
                <Button Content="Approve" Width="100" Click="Approve_Click" IsDefault="True" CornerRadius="6">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#3A6FF7" Offset="0"/>
                            <GradientStop Color="#7A3AF7" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>White</Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
