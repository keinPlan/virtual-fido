    <EmbeddedResource Include="Dashboard\*" />
    <ProjectReference Include="..\VFido.SecretManager\VFido.SecretManager.csproj" />
    <ProjectReference Include="..\VFido.SecretManager.FileBasedSecretStore\VFido.SecretManager.FileBasedSecretStore.csproj" />
  </ItemGroup>

</Project>
